clc; clear; close all;

% ----------------------------
% Numerical parameters
% ----------------------------
h   = 0.1;
T   = 40;
N   = round(T/h);
t   = 0:h:T;

eta = 0.9;                           % fractional order
gamma_eta = gamma(eta + 1);           % Gamma(eta+1)

% ----------------------------
% Model parameters
% ----------------------------
r1      = 0.028;
alph  = 0.72;
delta = 0.022;       
delta2 = 0.003;
lambda = 0.045;
lambda3 = 0.07;
xi    = 0.09;
xi8    = 0.01;
xi9   = 0.09;
K = 1;
r = r1^eta;
alpha = alph^eta;
delta0 = delta^eta;
delta1 = delta2^eta;
lambda1 = lambda^eta;
lambda2 = lambda3^eta;
xi1 = xi^eta;
xi2 = xi8^eta;
xi3 = xi9^eta;

% ----------------------------
% RHS (Fractional ODEs)
% ----------------------------
dN  = @(N,E,Ia,Ip,R) ...
      r*N.*(1 - N/K) ...
    - alpha*N.*(Ia+Ip)./(N+E+Ia+Ip+R) ...
    - delta0*N + delta1*R;

dE  = @(N,E,Ia,Ip,R) ...
      alpha*N.*(Ia+Ip)./(N+E+Ia+Ip+R) ...
    - (delta0 + lambda1 + lambda2).*E;

dIa = @(N,E,Ia,Ip,R) ...
      lambda1*E - (xi1 + xi2 + delta0).*Ia;

dIp = @(N,E,Ia,Ip,R) ...
      lambda2*E + xi2*Ia - (xi3 + delta0).*Ip;

dR  = @(N,E,Ia,Ip,R) ...
      xi1*Ia + xi3*Ip - (delta0 + delta1).*R;

% ----------------------------
% Initial conditions
% ----------------------------
Npop(1) = 1;
E(1) = 0.06;
Ia(1) = 0.02;
Ip(1) = 0.01;
R(1) = 0;

% ----------------------------
% Fractional RK-2 Integration
% ----------------------------
for k = 1:N

    % ---- k1 ----
    k1N  = dN(Npop(k),E(k),Ia(k),Ip(k),R(k));
    k1E  = dE(Npop(k),E(k),Ia(k),Ip(k),R(k));
    k1Ia = dIa(Npop(k),E(k),Ia(k),Ip(k),R(k));
    k1Ip = dIp(Npop(k),E(k),Ia(k),Ip(k),R(k));
    k1R  = dR(Npop(k),E(k),Ia(k),Ip(k),R(k));

    % ---- midpoint ----
    N_mid  = Npop(k) + 0.5*(h^eta)/gamma_eta * k1N;
    E_mid  = E(k)    + 0.5*(h^eta)/gamma_eta * k1E;
    Ia_mid = Ia(k)   + 0.5*(h^eta)/gamma_eta * k1Ia;
    Ip_mid = Ip(k)   + 0.5*(h^eta)/gamma_eta * k1Ip;
    R_mid  = R(k)    + 0.5*(h^eta)/gamma_eta * k1R;

    % ---- k2 ----
    k2N  = dN(N_mid,E_mid,Ia_mid,Ip_mid,R_mid);
    k2E  = dE(N_mid,E_mid,Ia_mid,Ip_mid,R_mid);
    k2Ia = dIa(N_mid,E_mid,Ia_mid,Ip_mid,R_mid);
    k2Ip = dIp(N_mid,E_mid,Ia_mid,Ip_mid,R_mid);
    k2R  = dR(N_mid,E_mid,Ia_mid,Ip_mid,R_mid);

    % ---- Update ----
    Npop(k+1) = Npop(k) + (h^eta)/gamma_eta * k2N;
    E(k+1)    = E(k)    + (h^eta)/gamma_eta * k2E;
    Ia(k+1)   = Ia(k)   + (h^eta)/gamma_eta * k2Ia;
    Ip(k+1)   = Ip(k)   + (h^eta)/gamma_eta * k2Ip;
    R(k+1)    = R(k)    + (h^eta)/gamma_eta * k2R;
end

% ----------------------------
% Plot results
% ----------------------------
figure('Color','w'); hold on; grid on;

plot(t,Npop,'LineWidth',2);
plot(t,E,'LineWidth',2);
plot(t,Ia,'LineWidth',2);
plot(t,Ip,'LineWidth',2);
plot(t,R,'LineWidth',2);

xlabel('Time (t)','FontSize',12,'FontWeight','bold');
ylabel('Population Fractions','FontSize',12,'FontWeight','bold');
title(sprintf('Fractional Model - CLS (\\eta = %.2f)',eta),...
      'FontSize',14,'FontWeight','bold');

legend({'N(t)','E(t)','I_a(t)','I_p(t)','R(t)'},...
       'Location','best','FontSize',12);
