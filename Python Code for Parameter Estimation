# ======================================================
# REPRODUCIBILITY
# ======================================================
SEED = 42
import random
random.seed(SEED)

import numpy as np
np.random.seed(SEED)

import torch
torch.manual_seed(SEED)
torch.cuda.manual_seed_all(SEED)
torch.backends.cudnn.deterministic = True
torch.backends.cudnn.benchmark = False

import torch.nn as nn
import torch.optim as optim
from scipy.optimize import minimize
from scipy.interpolate import interp1d

# ======================================================
# DATA (Observed: I = Ia + Ip)
# ======================================================
I_data = np.array([
    179.5,179.8,179.6,197.7,178.5,177.3,175.1,172.2,
    169.5,166.9,163.2,160.5,156.9,152.6,149.5,146,
    141.2,137.9,134.5,131.4,128,130.9
])

pop = 1e5
I_data_scaled = I_data / pop
years = np.arange(2000, 2000 + len(I_data_scaled))

# ======================================================
# PARAMETER NAMES & INITIAL GUESSES
# ======================================================
names = ["r","alpha","delta0","delta1","lambda1","lambda2","xi1","xi2","xi3"]

theta0 = np.array([
    0.03, 0.75, 0.02, 0.005,
    0.09, 0.10, 0.07, 0.01, 0.07
])

eta0 = 0.88
K = 1.0

# ======================================================
# CLS MODEL
# ======================================================
def simulate_model(theta, eta, years):
    r,a,d0,d1,l1,l2,x1,x2,x3 = theta

    rE,aE = r**eta, a**eta
    d0E,d1E = d0**eta, d1**eta
    l1E,l2E = l1**eta, l2**eta
    x1E,x2E,x3E = x1**eta, x2**eta, x3**eta

    dt = 0.1
    t = np.linspace(years[0], years[-1], int((years[-1]-years[0])/dt)+1)

    N,E,Ia,Ip,R = [np.zeros_like(t) for _ in range(5)]
    N[0],E[0],Ia[0],Ip[0],R[0] = 1.0,0.06,0.02,0.01,0.0

    for i in range(1,len(t)):
        Tot = N[i-1]+E[i-1]+Ia[i-1]+Ip[i-1]+R[i-1]
        inf = aE*N[i-1]*(Ia[i-1]+Ip[i-1])/Tot

        N[i]  = N[i-1] + dt*(rE*N[i-1]*(1-N[i-1]/K)-inf-d0E*N[i-1]+d1E*R[i-1])
        E[i]  = E[i-1] + dt*(inf-(d0E+l1E+l2E)*E[i-1])
        Ia[i] = Ia[i-1] + dt*(l1E*E[i-1]-(x1E+x2E+d0E)*Ia[i-1])
        Ip[i] = Ip[i-1] + dt*(l2E*E[i-1]+x2E*Ia[i-1]-(x3E+d0E)*Ip[i-1])
        R[i]  = R[i-1] + dt*(x1E*Ia[i-1]+x3E*Ip[i-1]-(d0E+d1E)*R[i-1])

    return interp1d(t, Ia+Ip)(years)

# ======================================================
# CLS OPTIMIZATION
# ======================================================
bounds = [
    (0.028,0.033),(0.72,0.77),
    (0.017,0.022),(0.003,0.008),
    (0.045,0.095),(0.07,0.12),
    (0.04,0.09),(0.007,0.012),(0.04,0.09),
    (0.90,0.95)
]

def cls_objective(z):
    return np.mean((simulate_model(z[:-1],z[-1],years)-I_data_scaled)**2)

z0 = np.concatenate([theta0,[eta0]])
res = minimize(cls_objective,z0,bounds=bounds,method="L-BFGS-B")

theta_cls = res.x[:-1]
eta_cls   = res.x[-1]

# ======================================================
# PINN MODEL
# ======================================================
t_tensor = torch.tensor(years,dtype=torch.float32).unsqueeze(-1)

class PINN(nn.Module):
    def __init__(self):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(1,64),nn.Tanh(),
            nn.Linear(64,64),nn.Tanh(),
            nn.Linear(64,5)
        )
    def forward(self,t): return self.net(t)

model = PINN()

theta = nn.Parameter(torch.log(torch.tensor(theta0,dtype=torch.float32)))
eta   = nn.Parameter(torch.tensor(0.88,dtype=torch.float32))

def clamp_params():
    with torch.no_grad():
        theta.data = torch.clamp(
            theta.data,
            torch.log(torch.tensor(0.3*theta0, dtype=torch.float32)),
            torch.log(torch.tensor(3.0*theta0, dtype=torch.float32))
        )
        eta.data = torch.clamp(eta.data, torch.tensor(0.88, dtype=torch.float32), torch.tensor(0.95, dtype=torch.float32))

# ======================================================
# PINN LOSS
# ======================================================
def pinn_loss():
    r,a,d0,d1,l1,l2,x1,x2,x3 = torch.exp(theta)
    e = eta

    rE,aE = r**e,a**e
    d0E,d1E = d0**e,d1**e
    l1E,l2E = l1**e,l2**e
    x1E,x2E,x3E = x1**e,x2**e,x3**e

    t_tensor.requires_grad_(True)
    N,E,Ia,Ip,R = model(t_tensor).T

    dN  = torch.autograd.grad(N,t_tensor,torch.ones_like(N),create_graph=True)[0]
    dE  = torch.autograd.grad(E,t_tensor,torch.ones_like(E),create_graph=True)[0]
    dIa = torch.autograd.grad(Ia,t_tensor,torch.ones_like(Ia),create_graph=True)[0]
    dIp = torch.autograd.grad(Ip,t_tensor,torch.ones_like(Ip),create_graph=True)[0]
    dR  = torch.autograd.grad(R,t_tensor,torch.ones_like(R),create_graph=True)[0]

    Tot = N+E+Ia+Ip+R
    inf = aE*N*(Ia+Ip)/Tot

    phys = (
        (dN-(rE*N*(1-N/K)-inf-d0E*N+d1E*R))**2 +
        (dE-(inf-(d0E+l1E+l2E)*E))**2 +
        (dIa-(l1E*E-(x1E+x2E+d0E)*Ia))**2 +
        (dIp-(l2E*E+x2E*Ia-(x3E+d0E)*Ip))**2 +
        (dR-(x1E*Ia+x3E*Ip-(d0E+d1E)*R))**2
    ).mean()

    data_loss = torch.mean((Ia+Ip - torch.tensor(I_data_scaled, dtype=torch.float32))**2)
    return data_loss + phys, phys

# ======================================================
# TRAINING
# ======================================================
optimizer = optim.Adam(list(model.parameters())+[theta,eta],lr=1e-3)

for epoch in range(4000):
    optimizer.zero_grad()
    loss, phys = pinn_loss()
    loss.backward()
    optimizer.step()
    clamp_params()

    if epoch % 1000 == 0:
        print(f"Epoch {epoch:5d} | Loss={loss.item():.3e} | Phys={phys.item():.3e} | eta={eta.item():.6f}")

# ======================================================
# FINAL PRINTING (CLEAR & PRECISE)
# ======================================================
print("\n================ CLS PARAMETERS ================")
for n,v in zip(names,theta_cls):
    print(f"{n:10s} = {v:.10e}")
print(f"eta        = {eta_cls:.10e}")

print("\n================ PINN PARAMETERS ================")
for n,v in zip(names,torch.exp(theta).detach().numpy()):
    print(f"{n:10s} = {v:.10e}")
print(f"eta        = {eta.item():.10e}")

print("\n=========== CLS vs PINN COMPARISON ==============")
print(f"{'Param':10s} | {'CLS':>14s} | {'PINN':>14s}")
print("-"*45)
for i,n in enumerate(names):
    print(f"{n:10s} | {theta_cls[i]:14.10e} | {torch.exp(theta[i]).item():14.10e}")
print(f"{'eta':10s} | {eta_cls:14.10e} | {eta.item():14.10e}")
